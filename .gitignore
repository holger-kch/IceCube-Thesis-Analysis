.venv/
venv/
env/
.env
.env.local
.env.*.local

# --- ML experiment tracking ---
wandb/
mlruns/
lightning_logs/
tb_logs/
runs/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# --- Allow plots even if a parent rule would catch them ---
!**/plots/**/*.png
!**/plots/**/*.pdf
!**/plots/**/*.svg
